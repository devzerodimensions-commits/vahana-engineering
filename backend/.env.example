# Copy this file to ".env" and fill in your own values.

# Server
PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS.
# In production this must be the deployed site, e.g.
# CLIENT_URL=https://vahana-engineering.onrender.com
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string (Neon).
# Get it from the Neon dashboard: Project -> Connection Details -> "Connection string".
# Use the POOLED connection (host contains "-pooler") for the running server —
# serverless Postgres has a low direct-connection limit.
# Neon requires SSL, so keep ?sslmode=require on the end.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# JSON Web Token — must be a long random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=7d

# Default admin account created by the seed script (npm run seed).
# CHANGE THE PASSWORD before seeding a production database.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@vihaanaengineering.com
ADMIN_PASSWORD=Admin@12345
